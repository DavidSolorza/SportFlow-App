								"exec": [
									"pm.test(\"Status code es 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.environment.set(\"jwt_token\", jsonData.token);",
									"    console.log(\"JWT Token guardado en entorno.\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
