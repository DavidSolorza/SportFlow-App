		{
			"name": "1. Autenticación & Control de Acceso (HU-SE-07, 08, 09, 10)",
			"item": [
				{
					"name": "1.1 Login con Credenciales (SuperAdmin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"if (jsonData.tokenAcceso) {",
									"    pm.environment.set(\"jwt_token\", jsonData.tokenAcceso);",
									"}",
									"if (jsonData.usuario && jsonData.usuario.id) {",
									"    pm.environment.set(\"admin_user_id\", jsonData.usuario.id);",
									"}",
									"if (jsonData.desafioToken) {",
									"    pm.environment.set(\"desafio_token\", jsonData.desafioToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Inicia sesión con credenciales tradicionales. Guarda automáticamente el token JWT en el entorno."
					},
					"response": []
				},
